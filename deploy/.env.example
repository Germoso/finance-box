# ===========================================================================
#  Plantilla de variables de entorno — despliegue de Sure
#
#  USO:  cp .env.example .env   y  rellenar los valores marcados <...>
#
#  ⚠️  NUNCA se sube `.env` a git, ni siquiera en un repo PRIVADO.
#      (regla propia del proyecto, y hallazgo B1 de la auditoría:
#       el upstream trae un SECRET_KEY_BASE público por defecto)
#
#  Generar secretos:   openssl rand -hex 64     (SECRET_KEY_BASE)
#                      openssl rand -hex 32     (el resto)
# ===========================================================================

# --- 1. OBLIGATORIO — jamás usar el default público a7523c3d... del upstream ---
SECRET_KEY_BASE=<openssl rand -hex 64>

# --- 2. Base de datos ---
POSTGRES_USER=sure
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=sure_production

# --- 3. Cifrado de datos sensibles (tokens de banco, MFA, PII) ---
# Explícitas para NO derivarlas de SECRET_KEY_BASE (auditoría B1).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=<openssl rand -hex 32>
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=<openssl rand -hex 32>
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=<openssl rand -hex 32>

# --- 4. Privacidad: sin telemetría hacia terceros (auditoría B2) ---
POSTHOG_FEEDBACK_ENABLED=false
POSTHOG_KEY=
POSTHOG_HOST=

# --- 5. APIs externas: vacías por defecto, nada sale de la máquina ---
OPENAI_ACCESS_TOKEN=
OPENAI_MODEL=
SENTRY_DSN=
SKYLIGHT_AUTHENTICATION=
SKYLIGHT_ENABLED=false
LOGTAIL_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- 6. Cotizaciones automáticas (auditoría: sin esto la tasa vence a los 5 días) ---
# Requiere el fix de IPv4 en compose.yml (gai.conf) para no fallar por IPv6.
EXCHANGE_RATE_PROVIDER=yahoo_finance

# --- 7. MCP: servidor para asistentes de IA (docs/hosting/mcp.md) ---
# MCP_API_TOKEN=<openssl rand -hex 32>
# MCP_USER_EMAIL=<email de la cuenta super_admin; requerido para el token estático>
MCP_API_TOKEN=
MCP_USER_EMAIL=

# --- 8. App ---
PORT=3000
# Si tu IP por DHCP cambia, usar "3000:3000" en compose.yml (expone en todas)
PORT_BIND=192.168.18.41
APP_DOMAIN=192.168.18.41:3000
SELF_HOSTED=true
ONBOARDING_STATE=open
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# --- 9. Acciones que NUNCA ejecutar en producción ---
#   rake data_migration:eu_plaid_webhooks  -> manda tus webhooks a app.sure.am
#   rake demo_data:default                 -> crea API key de demo no revocable
